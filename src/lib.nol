// nol.serde — sérialisation / désérialisation fiable, en pur Nolc.
//
// v0.2 : encodeur JSON CORRECT (échappement complet des chaînes) et composition
// d'objets/tableaux imbriqués. Le décodage typé et les formats additionnels
// (JSON Lines, MessagePack, TOML, YAML, CBOR) arrivent ensuite — voir README.
//
// Choix : pas d'arbre de valeurs récursif (un enum à charge utile récursif
// heurte un bug codegen connu de Nolc). On expose plutôt une API de COMPOSITION
// où chaque fragment est déjà du JSON valide, assemblé en objets et tableaux.

// Échappe une chaîne pour insertion entre guillemets JSON. L'antislash est
// traité EN PREMIER pour ne pas ré-échapper les séquences produites ensuite.
fn json_echappe(s: Text) -> Text {
    var r = replace(s, "\\", "\\\\")
    r = replace(r, "\"", "\\\"")
    r = replace(r, "\n", "\\n")
    r = replace(r, "\r", "\\r")
    r = replace(r, "\t", "\\t")
    return r
}

// ---- Valeurs scalaires (renvoient du JSON valide) ----

fn json_null() -> Text {
    return "null"
}
fn json_bool(b: Bool) -> Text {
    if b {
        return "true"
    }
    return "false"
}
fn json_entier(n: Int) -> Text {
    return text(n)
}
fn json_chaine(s: Text) -> Text {
    return "\"" + json_echappe(s) + "\""
}
// Insère une valeur déjà encodée (nombre à virgule, sous-document…) telle quelle.
fn json_brut(deja_json: Text) -> Text {
    return deja_json
}

// ---- Composition (les fragments passés sont déjà du JSON valide) ----

// Tableau JSON à partir d'éléments déjà encodés : [e1,e2,...].
fn json_tableau(elements: List<Text>) -> Text {
    var out = "["
    var premier = true
    for e in elements {
        if not premier {
            out = out + ","
        }
        out = out + e
        premier = false
    }
    return out + "]"
}

// Un champ d'objet : "clé":<valeur déjà encodée>.
fn json_champ(cle: Text, valeur_encodee: Text) -> Text {
    return json_chaine(cle) + ":" + valeur_encodee
}

// Objet JSON à partir de champs déjà rendus (via json_champ*) : {c1,c2,...}.
fn json_objet(champs: List<Text>) -> Text {
    var out = "{"
    var premier = true
    for c in champs {
        if not premier {
            out = out + ","
        }
        out = out + c
        premier = false
    }
    return out + "}"
}

// ---- Champs typés (raccourcis fréquents) ----

fn json_champ_chaine(cle: Text, valeur: Text) -> Text {
    return json_champ(cle, json_chaine(valeur))
}
fn json_champ_entier(cle: Text, n: Int) -> Text {
    return json_champ(cle, json_entier(n))
}
fn json_champ_bool(cle: Text, b: Bool) -> Text {
    return json_champ(cle, json_bool(b))
}

// Tableau de chaînes (chaque élément est échappé) : ["a","b"].
fn json_tableau_chaines(xs: List<Text>) -> Text {
    var encodes: List<Text> = []
    for x in xs {
        push(encodes, json_chaine(x))
    }
    return json_tableau(encodes)
}

// ============================ DÉCODEUR JSON ============================
//
// Parseur récursif-descendant fonctionnel : chaque fonction consomme depuis un
// index et renvoie l'index APRÈS la valeur (ou -1 si invalide). Pas d'arbre de
// valeurs (Nolc n'a pas d'enum récursif) : on valide, puis on extrait les
// champs à la demande (le cas d'usage courant : lire une réponse JSON).

fn est_espace(c: Text) -> Bool {
    return c == " " or c == "\t" or c == "\n" or c == "\r"
}
fn est_chiffre(c: Text) -> Bool {
    return unwrap_or(find("0123456789", c), -1) >= 0
}
fn saute_espaces(s: Text, i: Int) -> Int {
    var j = i
    while j < len(s) and est_espace(char_at(s, j)) {
        j += 1
    }
    return j
}
fn commence_par(s: Text, i: Int, mot: Text) -> Bool {
    return i + len(mot) <= len(s) and sub(s, i, len(mot)) == mot
}

// Consomme une chaîne « "..." » (gère les échappements). Renvoie l'index après
// le guillemet fermant, ou -1.
fn json_p_chaine(s: Text, i: Int) -> Int {
    if i >= len(s) or char_at(s, i) != "\"" {
        return -1
    }
    var j = i + 1
    while j < len(s) {
        let c = char_at(s, j)
        if c == "\\" {
            j += 2
        } else if c == "\"" {
            return j + 1
        } else {
            j += 1
        }
    }
    return -1
}

// Consomme un nombre JSON (signe, entier, fraction, exposant). Renvoie -1 si
// mal formé.
fn json_p_nombre(s: Text, i: Int) -> Int {
    var j = i
    if j < len(s) and char_at(s, j) == "-" {
        j += 1
    }
    let d0 = j
    while j < len(s) and est_chiffre(char_at(s, j)) {
        j += 1
    }
    if j == d0 {
        return -1
    }
    if j < len(s) and char_at(s, j) == "." {
        j += 1
        let f0 = j
        while j < len(s) and est_chiffre(char_at(s, j)) {
            j += 1
        }
        if j == f0 {
            return -1
        }
    }
    if j < len(s) and (char_at(s, j) == "e" or char_at(s, j) == "E") {
        j += 1
        if j < len(s) and (char_at(s, j) == "+" or char_at(s, j) == "-") {
            j += 1
        }
        let e0 = j
        while j < len(s) and est_chiffre(char_at(s, j)) {
            j += 1
        }
        if j == e0 {
            return -1
        }
    }
    return j
}

// Consomme une valeur JSON quelconque (récursif via tableau/objet).
fn json_p_valeur(s: Text, i0: Int) -> Int {
    let i = saute_espaces(s, i0)
    if i >= len(s) {
        return -1
    }
    let c = char_at(s, i)
    if c == "\"" {
        return json_p_chaine(s, i)
    }
    if c == "{" {
        return json_p_objet(s, i)
    }
    if c == "[" {
        return json_p_tableau(s, i)
    }
    if c == "-" or est_chiffre(c) {
        return json_p_nombre(s, i)
    }
    if commence_par(s, i, "true") {
        return i + 4
    }
    if commence_par(s, i, "false") {
        return i + 5
    }
    if commence_par(s, i, "null") {
        return i + 4
    }
    return -1
}

fn json_p_tableau(s: Text, i: Int) -> Int {
    var j = saute_espaces(s, i + 1)
    if j < len(s) and char_at(s, j) == "]" {
        return j + 1
    }
    var boucle = true
    while boucle {
        j = json_p_valeur(s, j)
        if j < 0 {
            return -1
        }
        j = saute_espaces(s, j)
        if j >= len(s) {
            return -1
        }
        let c = char_at(s, j)
        if c == "," {
            j = j + 1
        } else if c == "]" {
            return j + 1
        } else {
            return -1
        }
    }
    return -1
}

fn json_p_objet(s: Text, i: Int) -> Int {
    var j = saute_espaces(s, i + 1)
    if j < len(s) and char_at(s, j) == "}" {
        return j + 1
    }
    var boucle = true
    while boucle {
        j = saute_espaces(s, j)
        let fc = json_p_chaine(s, j)
        if fc < 0 {
            return -1
        }
        j = saute_espaces(s, fc)
        if j >= len(s) or char_at(s, j) != ":" {
            return -1
        }
        j = json_p_valeur(s, j + 1)
        if j < 0 {
            return -1
        }
        j = saute_espaces(s, j)
        if j >= len(s) {
            return -1
        }
        let c = char_at(s, j)
        if c == "," {
            j = j + 1
        } else if c == "}" {
            return j + 1
        } else {
            return -1
        }
    }
    return -1
}

// La chaîne est-elle un document JSON valide (une seule valeur, rien après) ?
fn json_valide(s: Text) -> Bool {
    let fin = json_p_valeur(s, 0)
    if fin < 0 {
        return false
    }
    return saute_espaces(s, fin) == len(s)
}

// Déséchappe le CONTENU d'une chaîne JSON (sans les guillemets).
fn json_desechappe(contenu: Text) -> Text {
    var r = replace(contenu, "\\\"", "\"")
    r = replace(r, "\\n", "\n")
    r = replace(r, "\\r", "\r")
    r = replace(r, "\\t", "\t")
    r = replace(r, "\\/", "/")
    r = replace(r, "\\\\", "\\")
    return r
}

// Valeur BRUTE (sous-chaîne JSON) d'un champ au niveau supérieur d'un objet.
fn json_lire_brut(s: Text, cle: Text) -> Option<Text> {
    var i = saute_espaces(s, 0)
    if i >= len(s) or char_at(s, i) != "{" {
        return none
    }
    i = saute_espaces(s, i + 1)
    if i < len(s) and char_at(s, i) == "}" {
        return none
    }
    var boucle = true
    while boucle {
        i = saute_espaces(s, i)
        let fc = json_p_chaine(s, i)
        if fc < 0 {
            return none
        }
        let cle_brute = sub(s, i + 1, fc - i - 2)
        i = saute_espaces(s, fc)
        if i >= len(s) or char_at(s, i) != ":" {
            return none
        }
        let debut_val = saute_espaces(s, i + 1)
        let fin_val = json_p_valeur(s, debut_val)
        if fin_val < 0 {
            return none
        }
        if cle_brute == cle {
            return some(sub(s, debut_val, fin_val - debut_val))
        }
        i = saute_espaces(s, fin_val)
        if i >= len(s) {
            return none
        }
        let c = char_at(s, i)
        if c == "," {
            i = i + 1
        } else {
            return none
        }
    }
    return none
}

// Champ chaîne (déséchappé) : none si absent ou pas une chaîne.
fn json_lire_texte(s: Text, cle: Text) -> Option<Text> {
    let v = json_lire_brut(s, cle)
    if not has(v) {
        return none
    }
    let brut = unwrap_or(v, "")
    if len(brut) < 2 or char_at(brut, 0) != "\"" {
        return none
    }
    return some(json_desechappe(sub(brut, 1, len(brut) - 2)))
}

// Champ entier : none si absent ou non entier.
fn json_lire_entier(s: Text, cle: Text) -> Option<Int> {
    let v = json_lire_brut(s, cle)
    if not has(v) {
        return none
    }
    return parse_int(unwrap_or(v, ""))
}

// Champ booléen : none si absent ou non booléen.
fn json_lire_bool(s: Text, cle: Text) -> Option<Bool> {
    let v = json_lire_brut(s, cle)
    if not has(v) {
        return none
    }
    let brut = unwrap_or(v, "")
    if brut == "true" {
        return some(true)
    }
    if brut == "false" {
        return some(false)
    }
    return none
}

// ============================ TESTS ============================

fn test_echappement() {
    // Guillemet, antislash, saut de ligne, tabulation.
    assert(json_chaine("a\"b") == "\"a\\\"b\"", "guillemet echappe")
    assert(json_chaine("a\\b") == "\"a\\\\b\"", "antislash echappe")
    assert(json_chaine("a\nb") == "\"a\\nb\"", "saut de ligne echappe")
    assert(json_chaine("a\tb") == "\"a\\tb\"", "tabulation echappee")
    assert(json_chaine("simple") == "\"simple\"", "chaine simple")
}

fn test_scalaires() {
    assert(json_null() == "null", "null")
    assert(json_bool(true) == "true", "true")
    assert(json_bool(false) == "false", "false")
    assert(json_entier(-7) == "-7", "entier negatif")
}

fn test_tableau() {
    var vide: List<Text> = []
    assert(json_tableau_chaines(vide) == "[]", "tableau vide")
    var xs: List<Text> = []
    push(xs, "a")
    push(xs, "b")
    assert(json_tableau_chaines(xs) == "[\"a\",\"b\"]", "tableau de chaines")
    // json_brut : insertion d'un nombre à virgule déjà rendu.
    var nums: List<Text> = []
    push(nums, json_brut("1.5"))
    push(nums, json_entier(2))
    assert(json_tableau(nums) == "[1.5,2]", "valeurs brutes")
}

fn test_objet() {
    var champs: List<Text> = []
    push(champs, json_champ_chaine("nom", "Alice"))
    push(champs, json_champ_entier("age", 30))
    push(champs, json_champ_bool("actif", true))
    assert(json_objet(champs) == "{\"nom\":\"Alice\",\"age\":30,\"actif\":true}", "objet compose")
}

fn test_imbrique() {
    // { "tags": ["x","y"], "meta": { "n": 1 } }
    var sous: List<Text> = []
    push(sous, json_champ_entier("n", 1))
    var racine: List<Text> = []
    push(racine, json_champ("tags", json_tableau_chaines(deux("x", "y"))))
    push(racine, json_champ("meta", json_objet(sous)))
    assert(json_objet(racine) == "{\"tags\":[\"x\",\"y\"],\"meta\":{\"n\":1}}", "structure imbriquee")
}

// Petite aide de test : liste de deux chaînes.
fn deux(a: Text, b: Text) -> List<Text> {
    var xs: List<Text> = []
    push(xs, a)
    push(xs, b)
    return xs
}

// ---- Décodeur ----

fn test_valide() {
    assert(json_valide("null"), "null")
    assert(json_valide("true"), "true")
    assert(json_valide("-12.5e3"), "nombre")
    assert(json_valide("\"abc\""), "chaine")
    assert(json_valide("[1, 2, 3]"), "tableau")
    assert(json_valide("{\"a\": 1, \"b\": [true, null]}"), "objet imbrique")
    assert(json_valide("  { \"x\" : \"y\" }  "), "espaces")
}

fn test_invalide() {
    assert(not json_valide("{"), "accolade non fermee")
    assert(not json_valide("[1, 2,]"), "virgule finale")
    assert(not json_valide("{\"a\" 1}"), "deux-points manquant")
    assert(not json_valide("truex"), "residu")
    assert(not json_valide("--1"), "double signe")
    assert(not json_valide(""), "vide")
}

fn test_extraction() {
    let doc = "{\"nom\": \"Alice\", \"age\": 30, \"actif\": true, \"note\": null}"
    assert(unwrap_or(json_lire_texte(doc, "nom"), "") == "Alice", "texte")
    assert(unwrap_or(json_lire_entier(doc, "age"), -1) == 30, "entier")
    assert(unwrap_or(json_lire_bool(doc, "actif"), false), "bool")
    assert(unwrap_or(json_lire_brut(doc, "note"), "") == "null", "champ brut null")
    assert(not has(json_lire_texte(doc, "absent")), "champ absent")
    assert(not has(json_lire_texte(doc, "age")), "age n'est pas un texte")
}

fn test_extraction_echappement() {
    let doc = "{\"msg\": \"dit \\\"salut\\\"\\nfin\"}"
    assert(unwrap_or(json_lire_texte(doc, "msg"), "") == "dit \"salut\"\nfin", "desechappement")
}

fn test_extraction_imbrique() {
    let doc = "{\"meta\": {\"n\": 1}, \"tags\": [\"a\", \"b\"]}"
    assert(unwrap_or(json_lire_brut(doc, "meta"), "") == "{\"n\": 1}", "sous-objet brut")
    assert(unwrap_or(json_lire_brut(doc, "tags"), "") == "[\"a\", \"b\"]", "tableau brut")
    // On peut redescendre dans le sous-objet extrait.
    assert(unwrap_or(json_lire_entier(unwrap_or(json_lire_brut(doc, "meta"), ""), "n"), -1) == 1, "descente")
}
